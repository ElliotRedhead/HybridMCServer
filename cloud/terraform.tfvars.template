# The shared secret for FRP tunnel authentication (e.g. generate with `openssl rand -hex 16`)
auth_token = "REPLACE_WITH_SECURE_TOKEN"

# Your DuckDNS token (from duckdns.org)
duckdns_token = "REPLACE_WITH_DUCKDNS_TOKEN"

# Your DuckDNS subdomain (e.g., "my-minecraft-server")
duckdns_domain = "REPLACE_WITH_SUBDOMAIN"

# Your FRP dashboard credentials
frp_dashboard_creds = {
  user = "REPLACE_WITH_USERNAME"
  pwd  = "REPLACE_WITH_PASSWORD"
}

# Optional: AWS settings (defaults shown). The availability zone must be in the region.
# aws_region        = "eu-west-2"
# availability_zone = "eu-west-2b"
# AWS CLI profile to use; leave unset to use your default AWS credentials
# aws_profile       = "my-lightsail-profile"
