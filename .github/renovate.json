{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["* 0-6 * * 1"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Gateway images set in cloud/main.tf locals",
      "managerFilePatterns": ["/^cloud/main\\.tf$/"],
      "matchStrings": ["_image\\s*=\\s*\"(?<depName>[^\":]+):(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "The server image tracks the rolling java21 tag; make mc-update pulls it",
      "matchPackageNames": ["itzg/minecraft-server"],
      "enabled": false
    },
    {
      "description": "frps and frpc must stay on the same version",
      "matchPackageNames": ["snowdreamtech/frps", "snowdreamtech/frpc"],
      "groupName": "frp"
    },
    {
      "description": "Batch the Terraform provider bumps into one PR",
      "matchManagers": ["terraform"],
      "groupName": "terraform providers"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  }
}
